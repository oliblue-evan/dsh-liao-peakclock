{
  "name": "dsh-peakclock",
  "version": "0.1.2",
  "description": "峰谷倒计时：模型名称中的时段与倒计时，附实时状态、显示预览和计费说明。",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "calendars",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale",
    "icon.svg",
    "dsh-plugin.naming.json",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "off-peak"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "node scripts/preview.mjs",
    "compatibility": "node scripts/check-compatibility.mjs",
    "check": "npm run compatibility && npm run typecheck && npm run build && npm test && npm run test:browser",
    "prepack": "npm run typecheck && npm run build",
    "test:artifact": "node scripts/check-artifact.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2"
  },
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliblue-evan/dsh-peakclock.git"
  },
  "homepage": "https://github.com/oliblue-evan/dsh-peakclock#readme",
  "bugs": {
    "url": "https://github.com/oliblue-evan/dsh-peakclock/issues"
  }
}
